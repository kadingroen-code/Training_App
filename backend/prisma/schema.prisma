// Prisma schema for Dynamic Endurance Training Platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  coach
  athlete
}

enum EventStatus {
  scheduled
  completed
  skipped
  cancelled
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  role          UserRole
  oauthTokens   Json      @default("{}") // Deprecated - use OAuthToken table
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  athleteProfile   AthleteProfile?
  workoutTemplates WorkoutTemplate[]
  calendarEvents   CalendarEvent[]
  oauthTokensNew  OAuthToken[]
}

model AthleteProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  currentVdot    Float?
  currentFtp     Float?
  maxHr          Int?
  thresholdPace  Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutTemplate {
  id            Int      @id @default(autoincrement())
  coachId       Int
  name          String
  description   String?
  sport         String
  logicJson     Json
  markdownSource String? @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coach          User            @relation(fields: [coachId], references: [id])
  calendarEvents CalendarEvent[]
}

model CalendarEvent {
  id              Int         @id @default(autoincrement())
  athleteId       Int
  templateId      Int
  scheduledDate   DateTime    @db.Date
  scheduledTime   DateTime?   @db.Timestamptz
  resolvedTargets Json
  status          EventStatus @default(scheduled)
  completionData  Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?   @db.Timestamptz

  athlete User            @relation(fields: [athleteId], references: [id])
  template WorkoutTemplate @relation(fields: [templateId], references: [id])
  pairsLogs PAIRSLog[]
}

model PAIRSLog {
  id              Int       @id @default(autoincrement())
  athleteId       Int
  calendarEventId Int?
  muscleSoreness  Int?
  jointPain       Int?
  notes           String?
  alertCoach      String    @default("false")
  createdAt       DateTime  @default(now())

  athlete      User           @relation(fields: [athleteId], references: [id])
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id])
}

model OAuthToken {
  id              Int       @id @default(autoincrement())
  userId          Int
  provider        String    // "garmin" | "strava"
  providerUserId  String?   // Garmin User ID (persistent identifier)
  
  // Tokens (encrypted at rest)
  accessToken     String    @db.Text
  refreshToken    String?   @db.Text
  tokenType       String    @default("Bearer")
  
  // Expiration tracking
  expiresAt       DateTime?
  refreshAt       DateTime? // When to refresh (5 min before expires)
  
  // Metadata
  scopes          String[]  // Requested scopes
  lastRefreshed   DateTime?
  refreshCount    Int       @default(0)
  status          String    @default("active") // "active" | "revoked" | "expired"
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relationships
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, provider])
  @@index([userId, provider])
  @@index([expiresAt])
  @@index([refreshAt])
}
