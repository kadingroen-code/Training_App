// Prisma schema for Dynamic Endurance Training Platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  coach
  athlete
}

enum EventStatus {
  scheduled
  completed
  skipped
  cancelled
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  role          UserRole
  oauthTokens   Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  athleteProfile   AthleteProfile?
  workoutTemplates WorkoutTemplate[]
  calendarEvents   CalendarEvent[]
}

model AthleteProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  currentVdot    Float?
  currentFtp     Float?
  maxHr          Int?
  thresholdPace  Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutTemplate {
  id            Int      @id @default(autoincrement())
  coachId       Int
  name          String
  description   String?
  sport         String
  logicJson     Json
  markdownSource String? @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coach          User            @relation(fields: [coachId], references: [id])
  calendarEvents CalendarEvent[]
}

model CalendarEvent {
  id              Int         @id @default(autoincrement())
  athleteId       Int
  templateId      Int
  scheduledDate   DateTime    @db.Date
  scheduledTime   DateTime?   @db.Timestamptz
  resolvedTargets Json
  status          EventStatus @default(scheduled)
  completionData  Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?   @db.Timestamptz

  athlete User            @relation(fields: [athleteId], references: [id])
  template WorkoutTemplate @relation(fields: [templateId], references: [id])
  pairsLogs PAIRSLog[]
}

model PAIRSLog {
  id              Int       @id @default(autoincrement())
  athleteId       Int
  calendarEventId Int?
  muscleSoreness  Int?
  jointPain       Int?
  notes           String?
  alertCoach      String    @default("false")
  createdAt       DateTime  @default(now())

  athlete      User           @relation(fields: [athleteId], references: [id])
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id])
}
